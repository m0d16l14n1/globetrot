[Unit]
Description=Globetrot session agent (layout switching and Globe actions)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@BINDIR@/globetrot-session --socket /run/globetrot/events.sock
ExecReload=@KILL@ -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
